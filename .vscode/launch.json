{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "NutriMind mobile (debug + hot reload)",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/flutter_app",
      "program": "${workspaceFolder}/flutter_app/lib/main.dart",
      "flutterMode": "debug"
    },
    {
      "name": "NutriMind iPhone / Android (profile + metrics)",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/flutter_app",
      "program": "${workspaceFolder}/flutter_app/lib/main.dart",
      "flutterMode": "profile",
      "toolArgs": [
        "--dart-define=PERF_METRICS=true",
        "--dart-define=API_BASE_URL=${input:nutrimindProfileApi}"
      ]
    }
  ],
  "inputs": [
    {
      "id": "nutrimindProfileApi",
      "type": "promptString",
      "description": "Backend URL reachable from the phone, e.g. http://192.168.1.20:8000 (same Wi-Fi as Mac)",
      "default": ""
    }
  ]
}
