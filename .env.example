# =============================================================================
# NutriMind — Single source of truth for all environment variables.
# Copy to `.env` and fill in real values. This file IS tracked in git.
# =============================================================================

# --- Database ----------------------------------------------------------------
POSTGRES_DB=nutrimind
POSTGRES_USER=nutrimind
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://nutrimind:changeme@postgres:5432/nutrimind

# --- Redis -------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://redis:6379
CACHE_TTL=300

# --- Auth --------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Frontend / CORS ---------------------------------------------------------
FRONTEND_URL=http://localhost:3000
# Used by the Next.js build to bake the API base URL into the bundle.
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_PORT=3000
BACKEND_PORT=8000

# --- AI providers ------------------------------------------------------------
# Gemini powers both the meal-photo analysis and the AI chat assistant.
GOOGLE_GEMINI_API_KEY=your-gemini-key
GEMINI_API_KEY=your-gemini-key
# Override the model without changing code (current default: gemini-2.5-flash-lite)
GEMINI_MODEL=gemini-2.5-flash-lite
USDA_API_KEY=DEMO_KEY

# --- Social / IdP sign-in ----------------------------------------------------
# Comma-separated list of Google OAuth client IDs whose ID tokens
# this backend will accept. At minimum this is the web client ID
# (the Flutter SDK passes it as the "server client ID" when
# requesting an ID token on Android and Web). Add the iOS and
# Android client IDs too — the same ID token is presented
# regardless of the platform the user signed in on, so a single
# allow-list covers all three. Apple / phone (added in a later
# step) will reuse the same auth-identity service function.
GOOGLE_AUTH_CLIENT_IDS=your-web-client-id,your-ios-client-id,your-android-client-id
# iOS client ID — kept here for documentation only; the Flutter
# build embeds the reversed URL scheme via --dart-define from
# this same value, while the backend reads the allow-list above.
GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

# --- Mail (MailHog locally, real SMTP in prod) -------------------------------
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_TLS=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@nutrimind.app
SMTP_FROM_NAME=NutriMind
MAILHOG_SMTP_PORT=1025
MAILHOG_WEB_PORT=8025

# --- Telegram bot (opt-in via `make up-telegram`) ----------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# --- Elastic APM (opt-in via `make up-elk`) ----------------------------------
ELASTIC_APM_ENABLED=false
ELASTIC_APM_SERVER_URL=http://localhost:8200
ELASTIC_APM_SERVICE_NAME=nutrimind-backend
ELASTIC_PORT=9200
KIBANA_PORT=5601
LOGSTASH_PORT=5044
APM_PORT=8200
ES_HEAP=512m