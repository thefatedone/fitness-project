# =============================================================================
# NutriMind — Single source of truth for all environment variables.
# Copy to `.env` and fill in real values. This file IS tracked in git.
# =============================================================================

# --- Database ----------------------------------------------------------------
POSTGRES_DB=nutrimind
POSTGRES_USER=nutrimind
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://nutrimind:changeme@postgres:5432/nutrimind

# --- Redis -------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://redis:6379
CACHE_TTL=300

# --- Auth --------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Frontend / CORS ---------------------------------------------------------
FRONTEND_URL=http://localhost:3000
# Used by the Next.js build to bake the API base URL into the bundle.
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_PORT=3000
BACKEND_PORT=8000

# --- AI providers ------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Override the chat model without changing code (current default: claude-sonnet-5)
ANTHROPIC_MODEL=claude-sonnet-5
GOOGLE_GEMINI_API_KEY=your-gemini-key
GEMINI_API_KEY=your-gemini-key
USDA_API_KEY=DEMO_KEY

# --- Mail (MailHog locally, real SMTP in prod) -------------------------------
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_TLS=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@nutrimind.app
SMTP_FROM_NAME=NutriMind
MAILHOG_SMTP_PORT=1025
MAILHOG_WEB_PORT=8025

# --- Telegram bot (opt-in via `make up-telegram`) ----------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# --- Elastic APM (opt-in via `make up-elk`) ----------------------------------
ELASTIC_APM_ENABLED=false
ELASTIC_APM_SERVER_URL=http://localhost:8200
ELASTIC_APM_SERVICE_NAME=nutrimind-backend
ELASTIC_PORT=9200
KIBANA_PORT=5601
LOGSTASH_PORT=5044
APM_PORT=8200
ES_HEAP=512m