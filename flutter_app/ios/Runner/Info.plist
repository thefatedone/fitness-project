<key>LSRequiresIPhoneOS</key>
<true/>
<!--
  Google sign-in URL scheme: the reversed iOS client ID from Google Cloud
  Console. The matching iOS client ID is passed to the Flutter build via
  --dart-define=GOOGLE_IOS_CLIENT_ID=... (see lib/core/config/app_config.dart).
  The two values must correspond to the same iOS client.
-->
<key>CFBundleURLTypes</key>
<array>
  <dict>
    <key>CFBundleURLName</key>
    <string>com.nutrimind.nutrimind.google</string>
    <key>CFBundleURLSchemes</key>
    <array>
      <string>com.googleusercontent.apps.198217538409-t7vjbhvnmgvk3qjr00hiotbs7edelp1f</string>
    </array>
  </dict>
</array>
